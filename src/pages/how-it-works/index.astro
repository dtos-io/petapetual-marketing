---
import DefaultPageLayout from "../../layouts/DefaultPageLayout.astro";
import Petapetual from "../../components/Petapetual.astro";
import PrayerStreamWidget from "../../components/PrayerStreamWidget.astro";
import TributeWidget from "../../components/TributeWidget.astro";
import DemoFamilyTree from "../../components/DemoFamilyTree.astro";
import { Image } from "astro:assets";

// Theme demo images
import ThemeRed from "../../assets/img/demos/themes/red.png";
import ThemeOrange from "../../assets/img/demos/themes/orange.png";
import ThemeYellow from "../../assets/img/demos/themes/yellow.png";
import ThemeGreen from "../../assets/img/demos/themes/green.png";
import ThemeBlue from "../../assets/img/demos/themes/blue.png";
import ThemeIndigo from "../../assets/img/demos/themes/indigo.png";
import ThemeViolet from "../../assets/img/demos/themes/violet.png";
import ThemeDirt from "../../assets/img/demos/themes/dirt.png";
import ThemeOffwhite from "../../assets/img/demos/themes/offwhite.png";
import ThemeThyme from "../../assets/img/demos/themes/thyme.png";
import ThemeSky from "../../assets/img/demos/themes/sky.png";
import ThemeLilac from "../../assets/img/demos/themes/lilac.png";
import ThemeGray from "../../assets/img/demos/themes/gray.png";
import ThemeEarthy from "../../assets/img/demos/themes/earthy.png";
import ThemeMono from "../../assets/img/demos/themes/mono.png";

const themes = [
    { name: "default", image: ThemeMono, color: "oklch(26.8% 0.007 34.298)" },
    { name: "coral", image: ThemeRed, color: "oklch(0.7 0.12 30)" },
    { name: "amber", image: ThemeOrange, color: "oklch(0.78 0.11 65)" },
    { name: "maize", image: ThemeYellow, color: "oklch(0.85 0.12 95)" },
    { name: "laurel", image: ThemeGreen, color: "oklch(0.72 0.1 145)" },
    { name: "cerulean", image: ThemeSky, color: "oklch(0.75 0.09 240)" },
    { name: "twilight", image: ThemeIndigo, color: "oklch(0.68 0.12 275)" },
    { name: "heather", image: ThemeViolet, color: "oklch(0.75 0.1 310)" },
    { name: "pebble", image: ThemeDirt, color: "oklch(0.6 0.04 20)" },
    { name: "sandstone", image: ThemeOffwhite, color: "oklch(0.7 0.06 85)" },
    { name: "lichen", image: ThemeThyme, color: "oklch(0.65 0.05 150)" },
    { name: "frost", image: ThemeBlue, color: "oklch(0.7 0.05 230)" },
    { name: "quartz", image: ThemeLilac, color: "oklch(0.65 0.06 290)" },
    { name: "ink", image: ThemeGray, color: "oklch(0.4 0 0)" },
    { name: "vellum", image: ThemeEarthy, color: "oklch(0.3 0.04 85)" },
];
---

<DefaultPageLayout
    id="top"
    title="Features"
    description="On-demand virtual blessings and prayers for your memorials. Pay respects to your loved ones anytime, anywhere."
>
    <div class="features-container">
        <!-- Hero Section -->
        <section class="features-hero">
            <h1 class="features-title">How It Works</h1>
            <p class="features-subtitle">
                Getting started with <Petapetual /> is simple. Create a beautiful,
                lasting memorial in minutes.
            </p>
        </section>

        <!-- Steps Section -->
        <section class="steps-section">
            <div class="steps-grid">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h3 class="step-title">Create a memorial</h3>
                    <p class="step-description">
                        Add a photo, name, birth/passing dates, and a short
                        epitaph for your loved one.
                    </p>
                </div>

                <div class="step-card">
                    <div class="step-number">2</div>
                    <h3 class="step-title">Invite family and friends</h3>
                    <p class="step-description">
                        Share your memorial with others so they can view it and
                        pay respects together.
                    </p>
                </div>

                <div class="step-card">
                    <div class="step-number">3</div>
                    <h3 class="step-title">Gather memories</h3>
                    <p class="step-description">
                        Add special dates, upload photos, and write heartfelt
                        messages.
                    </p>
                </div>

                <div class="step-card">
                    <div class="step-number">4</div>
                    <h3 class="step-title">Add prayers and tributes</h3>
                    <p class="step-description">
                        Subscribe to prayer streams and place meaningful
                        tributes at your memorial.
                    </p>
                </div>
            </div>
        </section>

        <!-- Features Grid -->
        <section class="features-grid-section">
            <!-- Memorials Feature -->
            <div class="feature-block" id="memorials">
                <div class="feature-header">
                    <div class="feature-icon">
                        <i class="fas fa-dove"></i>
                    </div>
                    <h2 class="feature-title">Memorials</h2>
                </div>

                <p class="feature-description">
                    A memorial is a dedicated page for your late loved one. It's
                    the heart of the <Petapetual /> experience—upload a photo, add
                    their name, dates, and a short epitaph to create a lasting tribute.
                    Choose from a variety of colour themes to further personalise
                    your space.
                </p>

                <!-- Theme Carousel -->
                <div class="theme-carousel">
                    <div class="theme-carousel-images">
                        {
                            themes.map((theme, index) => (
                                <div
                                    class={`theme-slide ${index === 0 ? "active" : ""}`}
                                    data-theme={theme.name}
                                >
                                    <Image
                                        src={theme.image}
                                        alt={`${theme.name} theme memorial demo`}
                                        class="theme-image"
                                        width={400}
                                    />
                                </div>
                            ))
                        }
                    </div>
                    <div class="theme-carousel-controls">
                        <p class="theme-label">Preview a theme:</p>
                        <div class="theme-dots">
                            {
                                themes.map((theme, index) => (
                                    <button
                                        class={`theme-dot ${index === 0 ? "active" : ""}`}
                                        data-index={index}
                                        data-theme={theme.name}
                                        style={`--dot-color: ${theme.color}`}
                                        aria-label={`View ${theme.name} theme`}
                                    />
                                ))
                            }
                        </div>
                    </div>
                </div>

                <div class="feature-cards">
                    <div class="info-card">
                        <h3 class="info-card-title">What you can do</h3>
                        <ul class="info-list">
                            <li>
                                Provide name, dates of birth and passing, and a
                                short epitaph.
                            </li>
                            <li>
                                Upload a display photo and build a photo
                                gallery.
                            </li>
                            <li>Record special dates in a timeline.</li>
                            <li>
                                Invite others to share memories in the
                                guestbook.
                            </li>
                        </ul>
                    </div>

                    <div class="info-card">
                        <h3 class="info-card-title">Privacy options</h3>
                        <ul class="info-list">
                            <li>
                                <strong>Invite-only:</strong> Share only with specific
                                people that you invite (they must have a <Petapetual
                                /> account)
                            </li>
                            <li>
                                <strong>Public:</strong> Anyone with the link can
                                view it
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Prayer Streams Feature -->
            <div class="feature-block" id="prayer-streams">
                <div class="feature-header">
                    <div class="feature-icon">
                        <i class="fas fa-hands-praying"></i>
                    </div>
                    <h2 class="feature-title">Prayer Streams</h2>
                </div>

                <p class="feature-description">
                    Prayer Streams provide continuous prayers for your memorial,
                    24 hours a day, 7 days a week. Choose from traditions across
                    different cultures and religions.
                </p>

                <div class="widgets-showcase">
                    <PrayerStreamWidget
                        iconClass="fa-solid fa-om"
                        bgClass="bg-indigo-500"
                    />
                    <PrayerStreamWidget
                        iconClass="fa-solid fa-cross"
                        bgClass="bg-emerald-500"
                    />
                    <PrayerStreamWidget
                        iconClass="fa-solid fa-yin-yang"
                        bgClass="bg-amber-500"
                    />
                </div>

                <div class="info-card">
                    <h3 class="info-card-title">How it works</h3>
                    <ol class="info-list-ordered">
                        <li>
                            Choose a tradition: Buddhist, Christian, Taoist, and
                            more
                        </li>
                        <li>Subscribe your memorial to the prayer stream</li>
                        <li>
                            Your loved one receives continuous prayers around
                            the clock
                        </li>
                    </ol>
                </div>

                <p class="feature-note">
                    Prayer Streams are included with all paid plans at no extra
                    cost.
                </p>
            </div>

            <!-- Tributes Feature -->
            <div class="feature-block" id="tributes">
                <div class="feature-header">
                    <div class="feature-icon">
                        <i class="fas fa-gift"></i>
                    </div>
                    <h2 class="feature-title">Tributes</h2>
                </div>

                <p class="feature-description">
                    Tributes are meaningful additions you can place at memorials
                    to honor your loved one. They range from decorative flowers
                    to active blessings.
                </p>

                <div class="widgets-showcase">
                    <TributeWidget
                        iconClass="fa-solid fa-om"
                        bgClass="bg-indigo-500"
                    />
                    <TributeWidget
                        iconClass="fa-solid fa-cross"
                        bgClass="bg-emerald-500"
                    />
                    <TributeWidget
                        iconClass="fa-solid fa-yin-yang"
                        bgClass="bg-amber-500"
                    />
                    <TributeWidget
                        iconClass="fa-solid fa-hands-praying"
                        bgClass="bg-rose-500"
                    />
                </div>

                <div class="tribute-types">
                    <div class="info-card">
                        <h3 class="info-card-title">
                            <i class="fas fa-seedling mr-2"></i>Decorative
                            Tributes
                        </h3>
                        <p class="info-card-text">
                            Flowers, candles, and symbolic items that beautify
                            the memorial.
                        </p>
                    </div>

                    <div class="info-card">
                        <h3 class="info-card-title">
                            <i class="fas fa-star mr-2"></i>Active Tributes
                        </h3>
                        <p class="info-card-text">
                            Tributes that deliver prayers or blessings to the
                            memorial continuously.
                        </p>
                    </div>
                </div>

                <p class="feature-text">
                    Everyone you invite can also place tributes, making it a
                    shared way to honor your loved one together.
                </p>
            </div>

            <!-- Family Trees Feature -->
            <div class="feature-block" id="family-trees">
                <div class="feature-header">
                    <div class="feature-icon">
                        <i class="fa-solid fa-code-fork"></i>
                    </div>
                    <h2 class="feature-title">Family Trees</h2>
                </div>

                <p class="feature-description">
                    If you have multiple memorials, you can link them together
                    to create a family tree. Specify relationships and visualize
                    your family's legacy.
                </p>

                <div class="family-tree-demo">
                    <DemoFamilyTree />
                </div>

                <div class="info-card">
                    <h3 class="info-card-title">What you can do</h3>
                    <ul class="info-list">
                        <li>
                            Link memorials together (parent, child, spouse,
                            sibling)
                        </li>
                        <li>Visualize relationships in an interactive tree</li>
                        <li>
                            Preserve your family history for future generations
                        </li>
                    </ul>
                </div>

                <p class="feature-note">
                    Family trees require 2+ memorials and are available on the
                    Essentials plan and above.
                </p>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="cta-section">
            <h2 class="cta-title">Ready to get started?</h2>
            <p class="cta-subtitle">
                Create your first memorial for free. No credit card required.
            </p>
            <div class="cta-buttons">
                <a href="https://app.petapetual.com" class="btn-cta-primary">
                    Get Started Free <i class="fas fa-arrow-right ml-1"></i>
                </a>
                <a href="/pricing" class="btn-cta-secondary"> View Pricing </a>
            </div>
        </section>
    </div>
</DefaultPageLayout>

<style>
    @reference "tailwindcss";

    .features-container {
        @apply flex flex-col gap-12;
    }

    /* Hero */
    .features-hero {
        @apply text-center py-8;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        @apply -mx-4 px-4 rounded-xl;
        @apply lg:-mx-8 lg:px-8;
    }

    .features-title {
        @apply text-3xl font-bold text-slate-800 mb-3;
        @apply lg:text-4xl;
    }

    .features-subtitle {
        @apply text-lg text-slate-600 max-w-2xl mx-auto;
    }

    /* Steps Section */
    .steps-section {
        @apply py-4;
    }

    .steps-grid {
        @apply grid gap-4;
        @apply md:grid-cols-2;
        @apply lg:grid-cols-4;
    }

    .step-card {
        @apply bg-white rounded-xl p-6 border border-slate-200 shadow-sm;
        @apply text-center;
    }

    .step-number {
        @apply w-10 h-10 rounded-full bg-slate-600 text-white;
        @apply flex items-center justify-center mx-auto mb-4;
        @apply font-bold text-lg;
    }

    .step-title {
        @apply font-semibold text-slate-700 mb-2;
    }

    .step-description {
        @apply text-sm text-slate-500;
    }

    /* Features Grid */
    .features-grid-section {
        @apply flex flex-col gap-12;
    }

    .feature-block {
        @apply flex flex-col gap-4;
        @apply p-6 rounded-xl;
        background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    }

    .feature-header {
        @apply flex items-center gap-3;
    }

    .feature-icon {
        @apply w-10 h-10 rounded-lg bg-slate-600 text-white;
        @apply flex items-center justify-center text-lg;
    }

    .feature-title {
        @apply text-xl font-semibold text-slate-700;
    }

    .feature-description {
        @apply text-slate-600 leading-relaxed;
    }

    .feature-text {
        @apply text-slate-600;
    }

    .feature-note {
        @apply text-slate-500 italic text-sm;
    }

    /* Theme Carousel */
    .theme-carousel {
        @apply flex flex-col gap-4;
    }

    .theme-carousel-images {
        @apply relative mx-auto grid;
        max-width: 256px;
    }

    .theme-slide {
        @apply opacity-0;
        grid-area: 1 / 1;
        transition: opacity 0.3s ease-in-out;
    }

    .theme-slide.active {
        @apply opacity-100;
    }

    .theme-image {
        @apply w-full h-auto rounded-xl shadow-md;
    }

    .theme-carousel-controls {
        @apply flex flex-col items-center gap-2;
    }

    .theme-label {
        @apply text-sm text-slate-500;
    }

    .theme-dots {
        @apply flex flex-wrap justify-center gap-2;
    }

    .theme-dot {
        @apply w-7 h-7 rounded-full cursor-pointer transition-all;
        @apply border-2 border-transparent;
        @apply hover:scale-110;
        background-color: var(--dot-color);
    }

    .theme-dot.active {
        @apply ring-2 ring-offset-2 ring-slate-400 scale-110;
    }

    /* Info Cards */
    .feature-cards {
        @apply grid gap-4;
        @apply md:grid-cols-2;
    }

    .tribute-types {
        @apply grid gap-4;
        @apply md:grid-cols-2;
    }

    .info-card {
        @apply bg-white p-4 rounded-xl border border-slate-200;
    }

    .info-card-title {
        @apply font-semibold text-slate-700 mb-3;
    }

    .info-card-text {
        @apply text-slate-600 text-sm;
    }

    .info-list {
        @apply list-disc list-inside space-y-1 text-slate-600 text-sm;
    }

    .info-list-ordered {
        @apply list-decimal list-inside space-y-1 text-slate-600 text-sm;
    }

    /* Widgets Showcase */
    .widgets-showcase {
        @apply flex flex-wrap gap-4 items-center justify-center my-4;
    }

    .family-tree-demo {
        @apply my-4 bg-white rounded-xl p-4 border border-slate-200;
    }

    /* CTA Section */
    .cta-section {
        @apply py-12 px-6 rounded-xl text-center;
        background: linear-gradient(135deg, #475569 0%, #64748b 100%);
    }

    .cta-title {
        @apply text-2xl font-bold text-white mb-3;
    }

    .cta-subtitle {
        @apply text-slate-200 mb-6;
    }

    .cta-buttons {
        @apply flex flex-col gap-3 justify-center;
        @apply sm:flex-row;
    }

    .btn-cta-primary {
        @apply p-3 px-6 bg-white text-slate-700 rounded-lg font-semibold;
        @apply hover:bg-slate-50 transition-colors;
    }

    .btn-cta-secondary {
        @apply p-3 px-6 border border-slate-300 text-white rounded-lg;
        @apply hover:bg-white/10 transition-colors;
    }
</style>

<script>
    // Theme Carousel
    const themeDots = document.querySelectorAll(".theme-dot");
    const themeSlides = document.querySelectorAll(".theme-slide");

    themeDots.forEach((dot) => {
        dot.addEventListener("click", () => {
            const index = parseInt(dot.getAttribute("data-index") || "0");

            // Update active dot
            themeDots.forEach((d) => d.classList.remove("active"));
            dot.classList.add("active");

            // Update active slide
            themeSlides.forEach((slide) => slide.classList.remove("active"));
            themeSlides[index]?.classList.add("active");
        });
    });
</script>
