---
import DefaultPageLayout from "../../layouts/DefaultPageLayout.astro";
import Petapetual from "../../components/Petapetual.astro";
import DemoFamilyTree from "../../components/DemoFamilyTree.astro";
import FeatureCTA from "../../components/FeatureCTA.astro";
---

<DefaultPageLayout
    title="Family Trees"
    description="Group and organize your memorials into family trees to show the relationships between your late loved ones. Build up the blueprint of your ancestry and continue building it with the next generation."
>
    <div class="page-container">
        <!-- Hero -->
        <section class="page-hero">
            <div class="hero-icon">
                <i class="fas fa-sitemap"></i>
            </div>
            <h1 class="page-title">Family Trees</h1>
            <p class="page-subtitle">
                Link your <a
                    href="/how-it-works/online-memorials"
                    class="text-slate-800 underline hover:text-slate-600"
                    >online memorials</a
                >
                together to form family trees. Document your legacy today, to share
                it with the generations of tomorrow.
            </p>
        </section>

        <!-- In Development Notice -->
        <div class="dev-callout">
            <i class="fas fa-hard-hat"></i>
            <div>
                <strong>Coming Soon</strong>
                <p>This feature is currently being developed and will be available in a future release.</p>
            </div>
        </div>

        <!-- Interactive Demo -->
        <section class="content-section">
            <DemoFamilyTree />
        </section>

        <!-- Features Grid -->
        <section class="features-grid">
            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-link text-indigo-600"></i>
                </div>
                <h3 class="feature-card-title">Link Memorials</h3>
                <p class="feature-card-text">
                    Connect your memorials to show parent-child, sibling,
                    spousal, and even pet relationships. Build a complete
                    picture of your family history.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-clock-rotate-left text-emerald-600"></i>
                </div>
                <h3 class="feature-card-title">Trace Your Legacy</h3>
                <p class="feature-card-text">
                    Document your ancestry and preserve it for future
                    generations. Your family tree becomes a living record of
                    your lineage.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-toggle-off text-amber-600"></i>
                </div>
                <h3 class="feature-card-title">Opt-In Feature</h3>
                <p class="feature-card-text">
                    Family trees are optional. Memorials don't have to be added
                    to a tree—use the feature only if it's meaningful to you.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-expand text-rose-600"></i>
                </div>
                <h3 class="feature-card-title">Grows With You</h3>
                <p class="feature-card-text">
                    Start small and expand over time. Add new memorials and
                    connections whenever you're ready to grow your tree.
                </p>
            </div>
        </section>

        <!-- Requirements -->
        <section class="content-section">
            <!-- <h2 class="section-title">Getting Started</h2> -->
            <div class="info-callout">
                <i class="fas fa-info-circle text-blue-600"></i>
                <div>
                    <strong>Requires 2+ Memorials</strong>
                    <p class="text-sm text-slate-600 mt-1">
                        Family trees require two or more memorials to work.
                        <a href="/pricing" class="blueLink"
                            >Subscribe to a paid plan</a
                        >
                        that allows for multiple memorials to use this feature.
                    </p>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <FeatureCTA />
    </div>
</DefaultPageLayout>

<style>
    @reference "tailwindcss";

    .page-container {
        @apply flex flex-col gap-10;
    }

    /* Hero */
    .page-hero {
        @apply text-center py-8;
        @apply -mx-4 px-4 rounded-xl;
        @apply lg:-mx-8 lg:px-8;
        background-color: var(--color-pp-light);
    }

    .hero-icon {
        @apply w-16 h-16 rounded-xl mx-auto mb-4;
        @apply flex items-center justify-center text-2xl;
        background-color: var(--color-pp-primary);
        color: var(--color-pp-light);
    }

    .page-title {
        @apply text-3xl font-bold mb-3;
        color: var(--color-pp-primary);
    }

    .page-subtitle {
        @apply text-lg max-w-2xl mx-auto;
        color: var(--color-pp-dark);
    }

    /* Sections */
    .content-section {
        @apply flex flex-col gap-4;
    }

    .section-title {
        @apply text-xl font-semibold;
        color: var(--color-pp-primary);
    }

    .section-text {
        color: var(--color-pp-dark);
    }

    /* Features Grid */
    .features-grid {
        @apply grid gap-4;
        @apply md:grid-cols-2;
    }

    .feature-card {
        @apply p-5 rounded-xl;
        background-color: var(--color-pp-light);
        border: 1px solid color-mix(in srgb, var(--color-pp-mid) 30%, transparent);
    }

    .feature-icon-small {
        @apply text-2xl mb-3;
    }

    .feature-card-title {
        @apply font-semibold mb-2;
        color: var(--color-pp-primary);
    }

    .feature-card-text {
        @apply text-sm;
        color: var(--color-pp-dark);
    }

    /* Info Callout */
    .info-callout {
        @apply flex items-start gap-3 p-4 rounded-lg;
        @apply bg-blue-50 border border-blue-200;
    }

    /* Dev Callout */
    .dev-callout {
        @apply flex items-start gap-3 p-4 rounded-lg;
        @apply bg-amber-50 border border-amber-300 text-amber-800;
    }

    .dev-callout p {
        @apply text-sm mt-1;
    }
</style>
