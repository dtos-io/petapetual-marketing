---
import DefaultPageLayout from "../../layouts/DefaultPageLayout.astro";
import Petapetual from "../../components/Petapetual.astro";
import PrayerStreamDemo from "../../components/PrayerStreamDemo.astro";
import FeatureCTA from "../../components/FeatureCTA.astro";
---

<DefaultPageLayout
    title="Prayer Streams"
    description="24/7 prayers for your memorials for any culture or religion. Pay respects to your loved ones anytime, anywhere."
>
    <div class="page-container">
        <!-- Hero -->
        <section class="page-hero">
            <div class="hero-icon">
                <i class="fas fa-pray"></i>
            </div>
            <h1 class="page-title">Prayer Streams</h1>
            <p class="page-subtitle">
                Continuous prayers for your loved one, around the clock. Inspired by
                prayer traditions from around the world—chanting temples, spinning
                prayer wheels, and places of worship that maintain constant vigils.
            </p>
        </section>

        <!-- Interactive Demo -->
        <section class="content-section">
            <h2 class="section-title">See It In Action</h2>
            <p class="section-text">
                Click on different traditions to see how prayer streams work. Each
                tradition has its own prayers and blessings delivered continuously.
            </p>
            <PrayerStreamDemo />
        </section>

        <!-- Features Grid -->
        <section class="features-grid">
            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-infinity text-indigo-600"></i>
                </div>
                <h3 class="feature-card-title">24/7 Continuous</h3>
                <p class="feature-card-text">
                    When you subscribe your memorial to a prayer stream, your loved
                    one is included in every prayer session, 24 hours a day, 7 days
                    a week.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-globe text-emerald-600"></i>
                </div>
                <h3 class="feature-card-title">Multiple Traditions</h3>
                <p class="feature-card-text">
                    Choose from prayers across different cultures and religions,
                    including Buddhist mantras, Christian prayers, Taoist blessings,
                    and more.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-list-check text-amber-600"></i>
                </div>
                <h3 class="feature-card-title">Prayer Log</h3>
                <p class="feature-card-text">
                    Every prayer delivered to your memorial is logged. View recent
                    prayers in the <Petapetual /> app anytime.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-gift text-rose-600"></i>
                </div>
                <h3 class="feature-card-title">Included Free</h3>
                <p class="feature-card-text">
                    Prayer Streams are included with all paid plans at no extra
                    cost. Subscribe your memorials when you create them.
                </p>
            </div>
        </section>

        <!-- How it works -->
        <section class="content-section">
            <h2 class="section-title">How It Works</h2>
            <div class="steps-list">
                <div class="step-item">
                    <span class="step-number">1</span>
                    <div class="step-content">
                        <strong>Choose a tradition</strong> that resonates with you or your loved one
                    </div>
                </div>
                <div class="step-item">
                    <span class="step-number">2</span>
                    <div class="step-content">
                        <strong>Subscribe your memorial</strong> to the prayer stream
                    </div>
                </div>
                <div class="step-item">
                    <span class="step-number">3</span>
                    <div class="step-content">
                        <strong>Your loved one receives prayers</strong> continuously, around the clock
                    </div>
                </div>
                <div class="step-item">
                    <span class="step-number">4</span>
                    <div class="step-content">
                        <strong>View the prayer log</strong> to see recent prayers delivered
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <FeatureCTA />
    </div>
</DefaultPageLayout>

<style>
    @reference "tailwindcss";

    .page-container {
        @apply flex flex-col gap-10;
    }

    /* Hero */
    .page-hero {
        @apply text-center py-8;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        @apply -mx-4 px-4 rounded-xl;
        @apply lg:-mx-8 lg:px-8;
    }

    .hero-icon {
        @apply w-16 h-16 rounded-xl bg-slate-600 text-white mx-auto mb-4;
        @apply flex items-center justify-center text-2xl;
    }

    .page-title {
        @apply text-3xl font-bold text-slate-800 mb-3;
    }

    .page-subtitle {
        @apply text-lg text-slate-600 max-w-2xl mx-auto;
    }

    /* Sections */
    .content-section {
        @apply flex flex-col gap-4;
    }

    .section-title {
        @apply text-xl font-semibold text-slate-700;
    }

    .section-text {
        @apply text-slate-600;
    }

    /* Features Grid */
    .features-grid {
        @apply grid gap-4;
        @apply md:grid-cols-2;
    }

    .feature-card {
        @apply p-5 rounded-xl border border-slate-200;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

    .feature-icon-small {
        @apply text-2xl mb-3;
    }

    .feature-card-title {
        @apply font-semibold text-slate-700 mb-2;
    }

    .feature-card-text {
        @apply text-slate-600 text-sm;
    }

    /* Steps */
    .steps-list {
        @apply flex flex-col gap-3;
    }

    .step-item {
        @apply flex items-start gap-4 p-4 rounded-lg bg-slate-50 border border-slate-200;
    }

    .step-number {
        @apply w-8 h-8 rounded-full bg-slate-600 text-white flex items-center justify-center;
        @apply font-semibold text-sm flex-shrink-0;
    }

    .step-content {
        @apply text-slate-700;
    }
</style>
