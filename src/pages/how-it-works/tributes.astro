---
import DefaultPageLayout from "../../layouts/DefaultPageLayout.astro";
import Petapetual from "../../components/Petapetual.astro";
import TributeWidget from "../../components/TributeWidget.astro";
import FeatureCTA from "../../components/FeatureCTA.astro";
---

<DefaultPageLayout
    title="Tributes"
    description="On-demand virtual blessings and prayers for your memorials. Pay respects to your loved ones anytime, anywhere."
>
    <div class="page-container">
        <!-- Hero -->
        <section class="page-hero">
            <div class="hero-icon">
                <i class="fas fa-gift"></i>
            </div>
            <h1 class="page-title">Memorial Tributes</h1>
            <p class="page-subtitle">
                Virtual offerings and blessings you can place on memorials. From simple
                decorations to digital versions of real-world tributes.
            </p>
        </section>

        <!-- Tribute Showcase -->
        <section class="content-section">
            <h2 class="section-title">Available Tributes</h2>
            <p class="section-text">
                Browse from our collection of tributes across different cultures and traditions.
                Place them on your memorials or let invited guests place their own.
            </p>
            <div class="tribute-showcase">
                <div class="tribute-grid">
                    <TributeWidget iconClass="fa-solid fa-om" bgClass="bg-indigo-600" />
                    <TributeWidget iconClass="fas fa-cross" bgClass="bg-emerald-600" />
                    <TributeWidget iconClass="fas fa-yin-yang" bgClass="bg-amber-600" />
                    <TributeWidget iconClass="fa-solid fa-person-praying" bgClass="bg-red-600" />
                    <TributeWidget iconClass="fa-solid fa-hands-praying" bgClass="bg-fuchsia-600" />
                    <TributeWidget iconClass="fas fa-dharmachakra" bgClass="bg-sky-600" />
                </div>
                <p class="showcase-note">
                    For illustrative purposes only. More tributes available in the app.
                </p>
            </div>
        </section>

        <!-- Features Grid -->
        <section class="features-grid">
            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-palette text-indigo-600"></i>
                </div>
                <h3 class="feature-card-title">Cosmetic Tributes</h3>
                <p class="feature-card-text">
                    Decorative offerings displayed on the memorial as a sign of respect.
                    The digital equivalent of placing flowers at your loved one's
                    resting place.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-bolt text-amber-600"></i>
                </div>
                <h3 class="feature-card-title">Active Tributes</h3>
                <p class="feature-card-text">
                    Both decorative and functional. Active tributes come with services
                    like additional <a href="/how-it-works/prayer-streams" class="blueLink">prayer streams</a>
                    for your memorial.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-users text-emerald-600"></i>
                </div>
                <h3 class="feature-card-title">Invite Others</h3>
                <p class="feature-card-text">
                    Any <Petapetual /> user you invite to your memorials can place their
                    own tributes, letting friends and family pay their respects together.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-layer-group text-rose-600"></i>
                </div>
                <h3 class="feature-card-title">Stackable Effects</h3>
                <p class="feature-card-text">
                    Multiple instances of the same tribute stack their effects. If several
                    people place active prayer tributes, all prayers are applied.
                </p>
            </div>
        </section>

        <!-- Pet Tributes -->
        <section class="content-section">
            <h2 class="section-title">For All Loved Ones</h2>
            <p class="section-text">
                Tributes aren't limited to religious or cultural themes. We offer
                culturally agnostic tributes like flowers, as well as special
                tributes for pet memorials.
            </p>
            <div class="tribute-showcase">
                <div class="tribute-grid">
                    <TributeWidget iconClass="fas fa-fan" bgClass="bg-slate-600" />
                    <TributeWidget iconClass="fas fa-bone -rotate-45" bgClass="bg-slate-600" />
                    <TributeWidget iconClass="fas fa-drumstick-bite" bgClass="bg-slate-600" />
                    <TributeWidget iconClass="fas fa-fish -rotate-45" bgClass="bg-slate-600" />
                    <TributeWidget iconClass="fas fa-paw" bgClass="bg-slate-600" />
                    <TributeWidget iconClass="fas fa-sailboat" bgClass="bg-slate-600" />
                </div>
            </div>
        </section>

        <!-- How It Works -->
        <section class="content-section">
            <h2 class="section-title">How Tributes Work</h2>
            <div class="tribute-demo">
                <div class="demo-step">
                    <p class="demo-label">1. Choose a tribute</p>
                    <div class="tribute-grid small">
                        <TributeWidget iconClass="fa-solid fa-hands-praying" bgClass="bg-fuchsia-600" />
                        <TributeWidget iconClass="fas fa-dharmachakra" bgClass="bg-sky-600" />
                    </div>
                </div>
                <div class="demo-arrow">
                    <i class="fas fa-arrow-right text-slate-400"></i>
                </div>
                <div class="demo-step">
                    <p class="demo-label">2. Place on memorial</p>
                    <div class="memorial-demo">
                        <span class="memorial-label">Your Memorial</span>
                        <div class="memorial-slots">
                            <TributeWidget iconClass="fa-solid fa-hands-praying" bgClass="bg-fuchsia-600" ping />
                            <TributeWidget iconClass="fas fa-dharmachakra" bgClass="bg-sky-600" ping />
                            <div class="empty-slot"></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <FeatureCTA />
    </div>
</DefaultPageLayout>

<style>
    @reference "tailwindcss";

    .page-container {
        @apply flex flex-col gap-10;
    }

    /* Hero */
    .page-hero {
        @apply text-center py-8;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        @apply -mx-4 px-4 rounded-xl;
        @apply lg:-mx-8 lg:px-8;
    }

    .hero-icon {
        @apply w-16 h-16 rounded-xl bg-slate-600 text-white mx-auto mb-4;
        @apply flex items-center justify-center text-2xl;
    }

    .page-title {
        @apply text-3xl font-bold text-slate-800 mb-3;
    }

    .page-subtitle {
        @apply text-lg text-slate-600 max-w-2xl mx-auto;
    }

    /* Sections */
    .content-section {
        @apply flex flex-col gap-4;
    }

    .section-title {
        @apply text-xl font-semibold text-slate-700;
    }

    .section-text {
        @apply text-slate-600;
    }

    /* Features Grid */
    .features-grid {
        @apply grid gap-4;
        @apply md:grid-cols-2;
    }

    .feature-card {
        @apply p-5 rounded-xl border border-slate-200;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

    .feature-icon-small {
        @apply text-2xl mb-3;
    }

    .feature-card-title {
        @apply font-semibold text-slate-700 mb-2;
    }

    .feature-card-text {
        @apply text-slate-600 text-sm;
    }

    /* Tribute Showcase */
    .tribute-showcase {
        @apply flex flex-col items-center gap-3;
    }

    .tribute-grid {
        @apply grid grid-cols-3 gap-2 p-3 bg-slate-100 rounded-lg;
    }

    .tribute-grid.small {
        @apply grid-cols-2;
    }

    .showcase-note {
        @apply text-sm text-slate-500 italic;
    }

    /* Tribute Demo */
    .tribute-demo {
        @apply flex flex-col items-center gap-4 p-6 bg-slate-50 rounded-xl border border-slate-200;
        @apply sm:flex-row sm:justify-center;
    }

    .demo-step {
        @apply flex flex-col items-center gap-2;
    }

    .demo-label {
        @apply text-sm font-medium text-slate-600;
    }

    .demo-arrow {
        @apply text-xl;
        @apply sm:rotate-0;
        @apply rotate-90;
    }

    .memorial-demo {
        @apply flex flex-col items-center gap-2 p-3 border-2 border-slate-800 rounded-lg bg-white;
    }

    .memorial-label {
        @apply text-sm font-medium text-slate-700;
    }

    .memorial-slots {
        @apply flex gap-2;
    }

    .empty-slot {
        @apply w-8 h-8 rounded bg-slate-200 shadow-inner;
    }
</style>
