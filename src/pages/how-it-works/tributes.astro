---
import DefaultPageLayout from "../../layouts/DefaultPageLayout.astro";
import Petapetual from "../../components/Petapetual.astro";
import TributeWidget from "../../components/TributeWidget.astro";
import FeatureCTA from "../../components/FeatureCTA.astro";
---

<DefaultPageLayout
    title="Tributes"
    description="On-demand virtual blessings and prayers for your memorials. Pay respects to your loved ones anytime, anywhere."
>
    <div class="page-container">
        <!-- Hero -->
        <section class="page-hero">
            <div class="hero-icon">
                <i class="fas fa-gift"></i>
            </div>
            <h1 class="page-title">Memorial Tributes</h1>
            <p class="page-subtitle">
                Virtual offerings and blessings you can place on memorials. From
                simple decorations to digital versions of their real-world
                counterparts.
            </p>
        </section>

        <!-- In Development Notice -->
        <div class="dev-callout">
            <i class="fas fa-hard-hat"></i>
            <div>
                <strong>Coming Soon</strong>
                <p>This feature is currently being developed and will be available in a future release.</p>
            </div>
        </div>

        <!-- Tribute Showcase -->
        <section class="content-section">
            <h2 class="section-title">Available Tributes</h2>
            <p class="section-text">
                Browse from our collection of tributes across different cultures
                and traditions. Place them on your memorials or let invited
                guests place their own.
            </p>
        </section>

        <!-- Features Grid -->
        <section class="features-grid">
            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-palette text-indigo-600"></i>
                </div>
                <h3 class="feature-card-title">Cosmetic Tributes</h3>
                <p class="feature-card-text">
                    Decorative offerings displayed on the memorial as a sign of
                    respect. The digital equivalent of placing flowers at your
                    loved one's resting place.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-bolt text-amber-600"></i>
                </div>
                <h3 class="feature-card-title">Active Tributes</h3>
                <p class="feature-card-text">
                    Both decorative and functional. Active tributes come with
                    services like additional <a
                        href="/how-it-works/prayer-streams"
                        class="blueLink">prayer streams</a
                    >
                    for your memorial.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-users text-emerald-600"></i>
                </div>
                <h3 class="feature-card-title">Invite Others</h3>
                <p class="feature-card-text">
                    Any <Petapetual /> user you invite to your memorials can place
                    their own tributes, letting friends and family pay their respects
                    together.
                </p>
            </div>

            <div class="feature-card">
                <div class="feature-icon-small">
                    <i class="fas fa-layer-group text-rose-600"></i>
                </div>
                <h3 class="feature-card-title">Stackable Effects</h3>
                <p class="feature-card-text">
                    Multiple instances of the same tribute stack their effects.
                    If several people place active prayer tributes, all prayers
                    are applied.
                </p>
            </div>
        </section>

        <!-- Pet Tributes -->
        <section class="content-section">
            <h2 class="section-title">For All Loved Ones</h2>
            <p class="section-text">
                Tributes aren't limited to religious or cultural themes. We
                offer culturally agnostic tributes like flowers, as well as
                special tributes for pet memorials.
            </p>
            <div class="tribute-showcase">
                <div class="tribute-grid">
                    <TributeWidget
                        iconClass="fas fa-fan"
                        bgClass="bg-slate-600"
                    />
                    <TributeWidget
                        iconClass="fas fa-bone -rotate-45"
                        bgClass="bg-slate-600"
                    />
                    <TributeWidget
                        iconClass="fas fa-drumstick-bite"
                        bgClass="bg-slate-600"
                    />
                    <TributeWidget
                        iconClass="fas fa-fish -rotate-45"
                        bgClass="bg-slate-600"
                    />
                    <TributeWidget
                        iconClass="fas fa-paw"
                        bgClass="bg-slate-600"
                    />
                    <TributeWidget
                        iconClass="fas fa-sailboat"
                        bgClass="bg-slate-600"
                    />
                </div>
            </div>
        </section>

        <!-- CTA -->
        <FeatureCTA />
    </div>
</DefaultPageLayout>

<style>
    @reference "tailwindcss";

    .page-container {
        @apply flex flex-col gap-10;
    }

    /* Hero */
    .page-hero {
        @apply text-center py-8;
        @apply -mx-4 px-4 rounded-xl;
        @apply lg:-mx-8 lg:px-8;
        background-color: var(--color-pp-light);
    }

    .hero-icon {
        @apply w-16 h-16 rounded-xl mx-auto mb-4;
        @apply flex items-center justify-center text-2xl;
        background-color: var(--color-pp-primary);
        color: var(--color-pp-light);
    }

    .page-title {
        @apply text-3xl font-bold mb-3;
        color: var(--color-pp-primary);
    }

    .page-subtitle {
        @apply text-lg max-w-2xl mx-auto;
        color: var(--color-pp-dark);
    }

    /* Sections */
    .content-section {
        @apply flex flex-col gap-4;
    }

    .section-title {
        @apply text-xl font-semibold;
        color: var(--color-pp-primary);
    }

    .section-text {
        color: var(--color-pp-dark);
    }

    /* Features Grid */
    .features-grid {
        @apply grid gap-4;
        @apply md:grid-cols-2;
    }

    .feature-card {
        @apply p-5 rounded-xl;
        background-color: var(--color-pp-light);
        border: 1px solid color-mix(in srgb, var(--color-pp-mid) 30%, transparent);
    }

    .feature-icon-small {
        @apply text-2xl mb-3;
    }

    .feature-card-title {
        @apply font-semibold mb-2;
        color: var(--color-pp-primary);
    }

    .feature-card-text {
        @apply text-sm;
        color: var(--color-pp-dark);
    }

    /* Tribute Showcase */
    .tribute-showcase {
        @apply flex flex-col items-center gap-3;
    }

    .tribute-grid {
        @apply grid grid-cols-3 gap-2 p-3 rounded-lg;
        background-color: var(--color-pp-light);
    }

    .tribute-grid.small {
        @apply grid-cols-2;
    }

    .showcase-note {
        @apply text-sm italic;
        color: var(--color-pp-mid);
    }

    /* Tribute Demo */
    .tribute-demo {
        @apply flex flex-col items-center gap-4 p-6 rounded-xl;
        @apply sm:flex-row sm:justify-center;
        background-color: var(--color-pp-light);
        border: 1px solid color-mix(in srgb, var(--color-pp-mid) 30%, transparent);
    }

    .demo-step {
        @apply flex flex-col items-center gap-2;
    }

    .demo-label {
        @apply text-sm font-medium;
        color: var(--color-pp-dark);
    }

    .demo-arrow {
        @apply text-xl;
        @apply sm:rotate-0;
        @apply rotate-90;
        color: var(--color-pp-mid);
    }

    .memorial-demo {
        @apply flex flex-col items-center gap-2 p-3 border-2 rounded-lg;
        border-color: var(--color-pp-primary);
        background-color: var(--color-pp-secondary);
    }

    .memorial-label {
        @apply text-sm font-medium;
        color: var(--color-pp-primary);
    }

    .memorial-slots {
        @apply flex gap-2;
    }

    .empty-slot {
        @apply w-8 h-8 rounded shadow-inner;
        background-color: color-mix(in srgb, var(--color-pp-mid) 30%, transparent);
    }

    /* Dev Callout */
    .dev-callout {
        @apply flex items-start gap-3 p-4 rounded-lg;
        @apply bg-amber-50 border border-amber-300 text-amber-800;
    }

    .dev-callout p {
        @apply text-sm mt-1;
    }
</style>
