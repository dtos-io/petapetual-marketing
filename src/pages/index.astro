---
import MasterLayout from "../layouts/MasterLayout.astro";
import { Image } from "astro:assets";

// How It Works tab data
const howItWorksTabs = [
    {
        id: "memorials",
        label: "Create your memorial",
        icon: "fa-dove ",
        steps: [
            {
                image: "/images/hiw/memorial-create.png",
                title: "Pick a theme",
                subtitle:
                    "Set a colour theme for your memorial. Choose from one of many palettes, across warm, cool, and neutral hues.",
            },
            {
                image: "/images/hiw/memorial-customize.png",
                title: "Provide your loved one's details",
                subtitle:
                    "Add a display photo, name, dates of birth and passing, and a short epitaph for your loved one.",
            },
            {
                image: "/images/hiw/memorial-customize.png",
                title: "(Optional) Choose a custom address",
                subtitle:
                    "Think of a short code that will function as a custom address for your memorial. This is mandatory for public memorials.",
            },
            {
                image: "/images/hiw/memorial-customize.png",
                title: "(Optional) Make your memorial public",
                subtitle:
                    "Decide whether you want your memorial to be public (anyone with the link can access it), or private (only invited users can access it).",
            },
        ],
    },
    {
        id: "sharing",
        label: "Customize your page",
        icon: "fa-palette",
        steps: [
            {
                image: "/images/hiw/share-invite.png",
                title: "Add funeral service information",
                subtitle:
                    "Provide information about any funeral services being held, such as the venue, time, virtual links, donation instructions, or other details.",
            },
            {
                image: "/images/hiw/share-public.png",
                title: "Record significant dates in your late one's life",
                subtitle:
                    "Share your loved one's milestones and special moments with our timeline widget.",
            },
            {
                image: "/images/hiw/share-public.png",
                title: "Add precious photo memories to the gallery",
                subtitle:
                    "Upload heartfelt and special images of your loved one and their life to the photo gallery.",
            },
        ],
    },
    {
        id: "memories",
        label: "Share with others",
        icon: "fa-share-nodes",
        steps: [
            {
                image: "/images/hiw/share-invite.png",
                title: "Invite family and friends",
                subtitle:
                    "Share your memorial with others on Petapetual so they can visit and pay respects.",
            },
            {
                image: "/images/hiw/memories-guestbook.png",
                title: "Write in the guestbook",
                subtitle:
                    "Leave heartfelt messages and share precious photos and memories on the guestbook widget.",
            },
            {
                image: "/images/hiw/memories-gallery.png",
                title: "Share your memorial with everyone",
                subtitle:
                    "Public memorials can be shared via link or QR code and visited by anyone, even if they do not have a Petapetual account.",
            },
        ],
    },
    {
        id: "services",
        label: "Add more services",
        icon: "fa-bolt",
        steps: [
            {
                image: "/images/hiw/services-prayers.png",
                title: "Subscribe to prayer streams",
                subtitle: "24/7 continuous prayers from various traditions.",
            },
            {
                image: "/images/hiw/services-tributes.png",
                title: "Place tributes",
                subtitle: "Add meaningful flowers, candles, and blessings.",
            },
        ],
    },
];

// Testimonials data
const testimonials = [
    {
        rating: 5,
        quote: "This gave our family a beautiful way to remember Grandma. Everyone could contribute their favorite memories.",
        name: "Sarah M.",
        location: "California, USA",
    },
    {
        rating: 5,
        quote: "The prayer streams feature brought so much comfort during a difficult time. Highly recommend.",
        name: "David L.",
        location: "Singapore",
    },
    {
        rating: 5,
        quote: "Simple to set up and the memorial looks beautiful. Our relatives overseas can now pay their respects too.",
        name: "Michelle T.",
        location: "Sydney, Australia",
    },
    {
        rating: 4,
        quote: "A wonderful way to keep my father's memory alive. The family tree feature is a lovely touch.",
        name: "James K.",
        location: "London, UK",
    },
];
---

<MasterLayout
    title="Petapetual"
    description="Online memorials to pay respects to your late loved ones. 24/7 virtualized prayer services and blessings available."
>
    <div class="page-container">
        <!-- Hero Section - Full screen on mobile -->
        <section class="hero">
            <div class="hero-content">
                <h1 class="hero-title">
                    Create beautiful memorials to treasure and share the stories
                    of your loved ones
                </h1>

                <p class="hero-subtitle">
                    Provide funeral information, write an epitaph, post memories
                    and significant dates. Invite others to view the memorial,
                    or make it public for the world to see.
                </p>

                <div class="hero-cta-group">
                    <a href="https://app.petapetual.com" class="btn-primary">
                        Create A Free Memorial <i
                            class="fas fa-arrow-right ml-1"></i>
                    </a>
                    <a href="#how-it-works" class="btn-secondary">
                        View Demo
                    </a>
                </div>
            </div>

            <div class="hero-mockup">
                <!-- Desktop mockup placeholder -->
            </div>

            <!-- Scroll indicator (mobile only) -->
            <div class="scroll-indicator">
                <a href="#benefits" class="scroll-indicator-link">
                    <i class="fas fa-chevron-down text-2xl"></i>
                </a>
            </div>
        </section>

        <!-- Key Benefits Section -->
        <section id="benefits" class="benefits-section">
            <div class="benefits-container">
                <div class="benefits-grid">
                    <div class="benefit-card">
                        <div class="benefit-icon">
                            <i class="fas fa-globe"></i>
                        </div>
                        <h3 class="benefit-title">Modern</h3>
                        <p class="benefit-description">
                            Elegant and clean memorial page designs that look
                            good on any screen.
                        </p>
                    </div>

                    <div class="benefit-card">
                        <div class="benefit-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <h3 class="benefit-title">Communal</h3>
                        <p class="benefit-description">
                            Invite loved ones to share heartfelt messages. Make
                            your memorial public for everyone to see.
                        </p>
                    </div>

                    <div class="benefit-card">
                        <div class="benefit-icon">
                            <i class="fas fa-palette"></i>
                        </div>
                        <h3 class="benefit-title">Customizable</h3>
                        <p class="benefit-description">
                            Infuse your memorials with personality by setting a
                            colour theme, adding significant dates, and more.
                        </p>
                    </div>

                    <div class="benefit-card">
                        <div class="benefit-icon">
                            <i class="fas fa-bolt"></i>
                        </div>
                        <h3 class="benefit-title">Integrated</h3>
                        <p class="benefit-description">
                            Enrich and enhance your memorial pages with our
                            value-added digital services.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- How It Works Section -->
        <section id="how-it-works" class="how-it-works-section">
            <div class="how-it-works-container">
                <h2 class="section-title">How It Works</h2>

                <!-- Tabs -->
                <div class="tabs-nav" role="tablist">
                    {
                        howItWorksTabs.map((tab, index) => (
                            <button
                                class={`tab-button ${index === 0 ? "active" : ""}`}
                                role="tab"
                                aria-selected={index === 0 ? "true" : "false"}
                                aria-controls={`panel-${tab.id}`}
                                data-tab={tab.id}
                            >
                                <i class={`fas ${tab.icon} tab-icon`} />
                                <span class="tab-label">{tab.label}</span>
                            </button>
                        ))
                    }
                </div>

                <!-- Tab Panels -->
                <div class="tab-panels">
                    {
                        howItWorksTabs.map((tab, index) => (
                            <div
                                id={`panel-${tab.id}`}
                                class={`tab-panel ${index === 0 ? "active" : ""}`}
                                role="tabpanel"
                                aria-hidden={index === 0 ? "false" : "true"}
                            >
                                <div class="steps-grid">
                                    {tab.steps.map((step) => (
                                        <div class="step-card">
                                            <div class="step-image-container">
                                                <div class="step-image-placeholder">
                                                    <i class="fas fa-image" />
                                                </div>
                                            </div>
                                            <div class="step-content">
                                                <h3 class="step-title">
                                                    {step.title}
                                                </h3>
                                                <p class="step-subtitle">
                                                    {step.subtitle}
                                                </p>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ))
                    }
                </div>

                <div class="learn-more">
                    <a href="/how-it-works" class="learn-more-link">
                        Learn more about our features <i
                            class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>

        <!-- Social Proof / Testimonials Section -->
        <section class="testimonials-section">
            <div class="testimonials-container">
                <h2 class="section-title">What Families Say</h2>

                <div class="carousel-wrapper">
                    <button
                        class="carousel-btn carousel-btn-prev"
                        aria-label="Previous testimonial"
                    >
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    <div class="carousel-track-container">
                        <div class="carousel-track">
                            {
                                testimonials.map((testimonial, index) => (
                                    <div
                                        class={`testimonial-card ${index === 0 ? "active" : ""}`}
                                        data-index={index}
                                    >
                                        <div class="testimonial-rating">
                                            {[...Array(5)].map((_, i) => (
                                                <i
                                                    class={`fas fa-star ${i < testimonial.rating ? "filled" : ""}`}
                                                />
                                            ))}
                                        </div>
                                        <blockquote class="testimonial-quote">
                                            "{testimonial.quote}"
                                        </blockquote>
                                        <div class="testimonial-author">
                                            <span class="testimonial-name">
                                                {testimonial.name}
                                            </span>
                                            <span class="testimonial-location">
                                                {testimonial.location}
                                            </span>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    <button
                        class="carousel-btn carousel-btn-next"
                        aria-label="Next testimonial"
                    >
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>

                <div class="carousel-dots">
                    {
                        testimonials.map((_, index) => (
                            <button
                                class={`carousel-dot ${index === 0 ? "active" : ""}`}
                                aria-label={`Go to testimonial ${index + 1}`}
                                data-index={index}
                            />
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Final CTA Section -->
        <section class="cta-section">
            <div class="cta-container">
                <h2 class="cta-title">Start Honoring Your Loved One Today</h2>
                <p class="cta-subtitle">
                    Create your first memorial for free. No credit card
                    required.
                </p>
                <div class="cta-buttons">
                    <a
                        href="https://app.petapetual.com"
                        class="btn-cta-primary"
                    >
                        Get Started Free <i class="fas fa-arrow-right ml-1"></i>
                    </a>
                    <a href="/pricing" class="btn-cta-secondary">
                        View Pricing
                    </a>
                </div>
            </div>
        </section>
    </div>
</MasterLayout>

<style>
    @reference "tailwindcss";

    /* Page Container */
    .page-container {
        @apply container mx-auto;
    }

    /* Hero Section */
    .hero {
        @apply min-h-dvh flex flex-col justify-center relative p-6;
        @apply lg:min-h-0 lg:p-16 lg:grid lg:grid-cols-2 lg:gap-12 lg:items-center;
    }

    .hero-content {
        @apply flex flex-col gap-4;
    }

    .hero-title {
        @apply text-3xl font-bold;
        @apply lg:text-4xl;
    }

    .hero-subtitle {
        @apply text-xl text-stone-600;
    }

    .hero-cta-group {
        @apply flex flex-col gap-3 mt-4;
        @apply sm:flex-row;
    }

    .hero-mockup {
        @apply hidden;
        @apply lg:flex;
    }

    /* Buttons */
    .btn-primary {
        @apply p-3 text-center bg-stone-800 text-stone-100 rounded font-semibold;
    }

    .btn-secondary {
        @apply p-3 text-center border border-stone-300 rounded;
    }

    /* Scroll Indicator */
    .scroll-indicator {
        @apply absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce;
        @apply lg:hidden;
    }

    .scroll-indicator-link {
        @apply text-stone-400;
    }

    /* Benefits Section */
    .benefits-section {
        @apply py-12 rounded-none;
        @apply lg:rounded-lg;
    }

    .benefits-container {
        @apply max-w-5xl mx-auto;
    }

    .benefits-grid {
        @apply grid grid-cols-1 gap-6;
        @apply md:grid-cols-2;
        @apply lg:grid-cols-4;
    }

    .benefit-card {
        @apply p-4 rounded-lg;
        @apply lg:p-2;
        text-align: center;
    }

    .benefit-icon {
        @apply text-3xl mb-3;
    }

    .benefit-title {
        @apply font-semibold text-lg mb-2;
    }

    .benefit-description {
        @apply text-stone-600;
    }

    /* How It Works Section */
    .how-it-works-section {
        @apply py-12 px-4;
    }

    .how-it-works-container {
        /*@apply max-w-4xl mx-auto;*/
    }

    .section-title {
        @apply text-2xl font-bold text-center mb-8;
    }

    /* Tabs */
    .tabs-nav {
        /*@apply flex flex-wrap justify-center gap-2;*/
        @apply grid grid-cols-4 gap-2 my-4;
        @apply sm:gap-4;
    }

    .tab-button {
        @apply cursor-pointer flex flex-col items-center justify-start gap-1 px-4 py-3 rounded-lg transition-all;
        @apply text-stone-500 bg-stone-100;
        @apply hover:bg-stone-200;
        @apply lg:flex-row lg:gap-2 lg:justify-center;
    }

    .tab-button.active {
        @apply bg-stone-800 text-white;
    }

    .tab-icon {
        @apply text-lg;
    }

    .tab-label {
        @apply text-sm font-medium;
        @apply sm:text-base;
    }

    .tab-panels {
        @apply relative;
    }

    .tab-panel {
        @apply hidden;
    }

    .tab-panel.active {
        @apply block;
    }

    .steps-grid {
        @apply grid gap-6;
        @apply md:grid-cols-2;
    }

    .step-card {
        @apply bg-stone-50 rounded-lg overflow-hidden border border-stone-200;
    }

    .step-image-container {
        @apply aspect-video bg-stone-200;
    }

    .step-image-placeholder {
        @apply w-full h-full flex items-center justify-center text-stone-400 text-4xl;
    }

    .step-content {
        @apply p-4;
    }

    .step-title {
        @apply font-semibold text-lg mb-1;
    }

    .step-subtitle {
        @apply text-stone-600 text-sm;
    }

    .learn-more {
        @apply text-center mt-8;
    }

    .learn-more-link {
        @apply text-blue-600 underline;
    }

    /* Testimonials Section */
    .testimonials-section {
        @apply py-12 px-4 bg-stone-100;
    }

    .testimonials-container {
        @apply max-w-4xl mx-auto;
    }

    .carousel-wrapper {
        @apply relative flex items-center gap-4;
    }

    .carousel-btn {
        @apply hidden w-10 h-10 rounded-full bg-white border border-stone-300 text-stone-600;
        @apply hover:bg-stone-50 transition-colors flex-shrink-0;
        @apply md:flex md:items-center md:justify-center;
    }

    .carousel-track-container {
        @apply overflow-hidden w-full;
    }

    .carousel-track {
        @apply flex transition-transform duration-300 ease-in-out;
    }

    .testimonial-card {
        @apply flex-shrink-0 w-full bg-white rounded-lg p-6 border border-stone-200;
    }

    .testimonial-rating {
        @apply flex gap-1 mb-3;
    }

    .testimonial-rating .fa-star {
        @apply text-stone-300;
    }

    .testimonial-rating .fa-star.filled {
        @apply text-amber-400;
    }

    .testimonial-quote {
        @apply text-lg text-stone-700 mb-4 italic;
    }

    .testimonial-author {
        @apply flex flex-col;
    }

    .testimonial-name {
        @apply font-semibold text-stone-800;
    }

    .testimonial-location {
        @apply text-sm text-stone-500;
    }

    .carousel-dots {
        @apply flex justify-center gap-2 mt-4;
    }

    .carousel-dot {
        @apply w-2 h-2 rounded-full bg-stone-300 transition-colors;
    }

    .carousel-dot.active {
        @apply bg-stone-800;
    }

    /* CTA Section */
    .cta-section {
        @apply bg-stone-800 text-stone-100 py-12 px-4 rounded-none;
        @apply lg:rounded-lg lg:mb-8;
    }

    .cta-container {
        @apply max-w-2xl mx-auto text-center;
    }

    .cta-title {
        @apply text-2xl font-bold mb-4;
    }

    .cta-subtitle {
        @apply text-stone-300 mb-6;
    }

    .cta-buttons {
        @apply flex flex-col gap-3 justify-center;
        @apply sm:flex-row;
    }

    .btn-cta-primary {
        @apply p-3 px-6 bg-stone-100 text-stone-800 rounded font-semibold;
    }

    .btn-cta-secondary {
        @apply p-3 px-6 border border-stone-400 rounded;
    }
</style>

<script>
    // Tab switching functionality
    document.addEventListener("DOMContentLoaded", () => {
        const tabButtons = document.querySelectorAll(".tab-button");
        const tabPanels = document.querySelectorAll(".tab-panel");

        tabButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const tabId = button.getAttribute("data-tab");

                // Update buttons
                tabButtons.forEach((btn) => {
                    btn.classList.remove("active");
                    btn.setAttribute("aria-selected", "false");
                });
                button.classList.add("active");
                button.setAttribute("aria-selected", "true");

                // Update panels
                tabPanels.forEach((panel) => {
                    panel.classList.remove("active");
                    panel.setAttribute("aria-hidden", "true");
                });
                const activePanel = document.getElementById(`panel-${tabId}`);
                if (activePanel) {
                    activePanel.classList.add("active");
                    activePanel.setAttribute("aria-hidden", "false");
                }
            });
        });

        // Carousel functionality
        const track = document.querySelector(".carousel-track") as HTMLElement;
        const cards = document.querySelectorAll(".testimonial-card");
        const dots = document.querySelectorAll(".carousel-dot");
        const prevBtn = document.querySelector(".carousel-btn-prev");
        const nextBtn = document.querySelector(".carousel-btn-next");
        let currentIndex = 0;
        const totalCards = cards.length;

        function updateCarousel(index: number) {
            currentIndex = index;
            if (track) {
                track.style.transform = `translateX(-${index * 100}%)`;
            }

            dots.forEach((dot, i) => {
                dot.classList.toggle("active", i === index);
            });
        }

        function nextSlide() {
            const newIndex = (currentIndex + 1) % totalCards;
            updateCarousel(newIndex);
        }

        function prevSlide() {
            const newIndex = (currentIndex - 1 + totalCards) % totalCards;
            updateCarousel(newIndex);
        }

        prevBtn?.addEventListener("click", prevSlide);
        nextBtn?.addEventListener("click", nextSlide);

        dots.forEach((dot) => {
            dot.addEventListener("click", () => {
                const index = parseInt(dot.getAttribute("data-index") || "0");
                updateCarousel(index);
            });
        });

        // Auto-advance carousel every 5 seconds
        setInterval(nextSlide, 5000);
    });
</script>
