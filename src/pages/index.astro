---
import MasterLayout from "../layouts/MasterLayout.astro";
import { Image } from "astro:assets";

import MemorialGuestbookMockup from "../assets/img/mockup-memorial-guestbook.png";
---

<MasterLayout
    title="Petapetual"
    description="Online memorials to pay respects to your late loved ones. 24/7 virtualized prayer services and blessings available."
>
    <div class="container mx-auto">
        <section class="flex flex-col gap-4 p-4 lg:grid lg:grid-cols-3 lg:m-16">
            <div class="col-span-2 flex flex-col gap-2">
                <h1 class="text-3xl font-bold col-start-1">
                    Petapetual: Digital memorials that bring tradition into the
                    modern world
                </h1>

                <h2 class="text-xl col-start-1">
                    Petapetual is an <a
                        href="/how-it-works/online-memorials"
                        class="blueLink">online memorial service</a
                    > that lets you honour and pay respects to your late loved ones
                    anytime, anywhere.
                </h2>

                <div class="h-10/12 lg:hidden flex">
                    <Image
                        class="h-full w-full object-contain"
                        inferSize
                        src={MemorialGuestbookMockup}
                        alt="petapetual guestbook mockup"
                    />
                </div>

                <div class="flex flex-col gap-4 my-4">
                    <p class="text-lg">
                        <i class="fas fa-circle-check text-green-600"></i>
                        Works on mobile, tablet, and desktop with no app installation
                        required.
                    </p>
                    <p class="text-lg">
                        <i class="fas fa-circle-check text-green-600"></i>
                        Invite your friends and family to view your memorials and
                        leave messages on the guestbooks.
                    </p>
                    <p class="text-lg">
                        <i class="fas fa-circle-check text-green-600"></i>
                        Use our virtualized <a
                            href="/how-it-works/prayer-streams"
                            class="blueLink">prayer streams</a
                        > and <a href="/how-it-works/tributes" class="blueLink"
                            >memorial tribute</a
                        > services to decorate and honour your memorials, even when
                        you're away.
                    </p>
                    <p class="text-lg">
                        <i class="fas fa-circle-check text-green-600"></i>
                        Link your memorials and build family trees.
                    </p>
                </div>

                <div class="gap-2 flex flex-col col-start-1">
                    <a
                        href="/how-it-works"
                        class="p-2 border rounded text-center"
                        ><i class="fas fa-lightbulb"></i> How it works
                    </a>

                    <a
                        href="/roadmap"
                        class="p-2 bg-yellow-400 rounded text-center"
                        ><i class="fas fa-road"></i> Roadmap
                    </a>

                    <a
                        href="https://app.petapetual.com"
                        class="p-2 text-center bg-stone-800 text-stone-200 rounded"
                        >Go to app <i class="fas fa-arrow-right"></i></a
                    >
                </div>
            </div>

            <div class="h-10/12 hidden lg:flex">
                <Image
                    class="h-full w-full object-contain"
                    inferSize
                    src={MemorialGuestbookMockup}
                    alt="petapetual guestbook mockup"
                />
            </div>
        </section>
    </div>
</MasterLayout>
