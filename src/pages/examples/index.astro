---
import DefaultPageLayout from "../../layouts/DefaultPageLayout.astro";
import Petapetual from "../../components/Petapetual.astro";
---

<DefaultPageLayout
    title="Who Is Petapetual For?"
    description="Online memorials for everyone - family, friends, and pets. Pay respects from anywhere, on your schedule."
>
    <div class="flex flex-col gap-10">
        <section>
            <h1 class="text-2xl font-semibold">Who Is Petapetual For?</h1>
            <p class="text-lg text-stone-600 mt-2">
                <Petapetual /> is for anyone who wants to honor someone they've lost.
                Whether family, friend, or pet—we're here to help you remember.
            </p>
        </section>

        <!-- By Relationship -->
        <section>
            <h2 class="text-xl font-semibold mb-4">By Relationship</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <a href="/examples/relatives" class="group block bg-stone-50 border border-stone-200 rounded-lg p-6 hover:border-sky-400 hover:shadow transition-all">
                    <div class="text-3xl mb-3 text-sky-600">
                        <i class="fas fa-people-group"></i>
                    </div>
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-sky-600">For Relatives</h3>
                    <p class="text-stone-600">
                        Honor parents, grandparents, siblings, and family members who shaped your life.
                    </p>
                </a>

                <a href="/examples/friends" class="group block bg-stone-50 border border-stone-200 rounded-lg p-6 hover:border-green-400 hover:shadow transition-all">
                    <div class="text-3xl mb-3 text-green-600">
                        <i class="fas fa-user-group"></i>
                    </div>
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-green-600">For Friends</h3>
                    <p class="text-stone-600">
                        Celebrate the family you chose—friends who became like siblings.
                    </p>
                </a>

                <a href="/examples/pets" class="group block bg-stone-50 border border-stone-200 rounded-lg p-6 hover:border-amber-400 hover:shadow transition-all">
                    <div class="text-3xl mb-3 text-amber-600">
                        <i class="fas fa-paw"></i>
                    </div>
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-amber-600">For Pets</h3>
                    <p class="text-stone-600">
                        Remember the companions who gave unconditional love and joy.
                    </p>
                </a>
            </div>
        </section>

        <!-- By Life Situation -->
        <section>
            <h2 class="text-xl font-semibold mb-4">By Life Situation</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <a href="/examples/living-abroad" class="group block bg-stone-50 border border-stone-200 rounded-lg p-6 hover:border-indigo-400 hover:shadow transition-all">
                    <div class="text-3xl mb-3 text-indigo-600">
                        <i class="fas fa-plane"></i>
                    </div>
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-indigo-600">Living Abroad</h3>
                    <p class="text-stone-600">
                        Pay respects from anywhere in the world, no matter the distance.
                    </p>
                </a>

                <a href="/examples/too-busy" class="group block bg-stone-50 border border-stone-200 rounded-lg p-6 hover:border-purple-400 hover:shadow transition-all">
                    <div class="text-3xl mb-3 text-purple-600">
                        <i class="fas fa-briefcase"></i>
                    </div>
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-purple-600">Too Busy</h3>
                    <p class="text-stone-600">
                        Honor your loved ones on your schedule, whenever you have a moment.
                    </p>
                </a>

                <a href="/examples/learn-culture" class="group block bg-stone-50 border border-stone-200 rounded-lg p-6 hover:border-red-400 hover:shadow transition-all">
                    <div class="text-3xl mb-3 text-red-600">
                        <i class="fas fa-hands-praying"></i>
                    </div>
                    <h3 class="font-semibold text-lg mb-2 group-hover:text-red-600">Learning Your Culture</h3>
                    <p class="text-stone-600">
                        Get guidance on traditional practices with cultural preferences.
                    </p>
                </a>
            </div>
        </section>

        <!-- What Everyone Gets -->
        <section class="bg-stone-200 p-6 rounded-lg">
            <h2 class="text-xl font-semibold mb-4">What Everyone Gets</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex items-start gap-3">
                    <i class="fas fa-circle-check text-green-600 mt-1"></i>
                    <div>
                        <div class="font-semibold">Access 24/7</div>
                        <div class="text-stone-600 text-sm">Visit your memorial anytime, from any device</div>
                    </div>
                </div>

                <div class="flex items-start gap-3">
                    <i class="fas fa-circle-check text-green-600 mt-1"></i>
                    <div>
                        <div class="font-semibold">Private by Default</div>
                        <div class="text-stone-600 text-sm">Control who can see your memorials</div>
                    </div>
                </div>

                <div class="flex items-start gap-3">
                    <i class="fas fa-circle-check text-green-600 mt-1"></i>
                    <div>
                        <div class="font-semibold">Guestbook</div>
                        <div class="text-stone-600 text-sm">Collect messages and memories from loved ones</div>
                    </div>
                </div>

                <div class="flex items-start gap-3">
                    <i class="fas fa-circle-check text-green-600 mt-1"></i>
                    <div>
                        <div class="font-semibold">Prayer Streams</div>
                        <div class="text-stone-600 text-sm">24/7 prayers in your chosen tradition (paid plans)</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="bg-stone-800 text-stone-100 p-8 rounded-lg text-center">
            <h2 class="text-xl font-bold mb-3">Ready to honor your loved one?</h2>
            <p class="text-stone-300 mb-4">Create your first memorial for free.</p>
            <a
                href="https://app.petapetual.com"
                class="inline-block p-3 px-6 bg-stone-100 text-stone-800 rounded font-semibold"
            >
                Get Started <i class="fas fa-arrow-right ml-1"></i>
            </a>
        </section>
    </div>
</DefaultPageLayout>
