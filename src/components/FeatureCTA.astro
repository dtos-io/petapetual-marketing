---
interface Props {
    title?: string;
    subtitle?: string;
    showPricing?: boolean;
}

const {
    title = "Ready to get started?",
    subtitle = "Create your first memorial for free. No credit card required.",
    showPricing = true,
} = Astro.props;
---

<section class="cta-section">
    <h2 class="cta-title">{title}</h2>
    <p class="cta-subtitle">{subtitle}</p>
    <div class="cta-buttons">
        <a href="https://app.petapetual.com" class="btn-cta-primary">
            Get Started Free <i class="fas fa-arrow-right ml-1"></i>
        </a>
        {showPricing && <a href="/pricing" class="btn-cta-secondary">View Pricing</a>}
    </div>
</section>

<style>
    @reference "tailwindcss";

    .cta-section {
        @apply py-12 px-6 rounded-xl text-center mt-8;
        background: linear-gradient(135deg, #475569 0%, #64748b 100%);
    }

    .cta-title {
        @apply text-2xl font-bold text-white mb-3;
    }

    .cta-subtitle {
        @apply text-slate-200 mb-6;
    }

    .cta-buttons {
        @apply flex flex-col gap-3 justify-center;
        @apply sm:flex-row;
    }

    .btn-cta-primary {
        @apply p-3 px-6 bg-white text-slate-700 rounded-lg font-semibold no-underline;
        @apply hover:bg-slate-50 transition-colors;
    }

    .btn-cta-secondary {
        @apply p-3 px-6 border border-slate-300 text-white rounded-lg no-underline;
        @apply hover:bg-white/10 transition-colors;
    }
</style>
