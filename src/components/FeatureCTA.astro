---
interface Props {
    title?: string;
    subtitle?: string;
    showPricing?: boolean;
}

const {
    title = "Ready to get started?",
    subtitle = "Create your first memorial for free. No credit card required.",
    showPricing = true,
} = Astro.props;
---

<section class="cta-section">
    <h2 class="cta-title">{title}</h2>
    <p class="cta-subtitle">{subtitle}</p>
    <div class="cta-buttons">
        <a href="https://app.petapetual.com" class="btn-cta-primary">
            Get Started Free <i class="fas fa-arrow-right ml-1"></i>
        </a>
        {showPricing && <a href="/pricing" class="btn-cta-secondary">View Pricing</a>}
    </div>
</section>

<style>
    @reference "tailwindcss";

    .cta-section {
        @apply py-12 px-6 rounded-xl text-center mt-8;
        background: linear-gradient(135deg, var(--color-pp-primary) 0%, color-mix(in srgb, var(--color-pp-primary) 80%, #000) 100%);
    }

    .cta-title {
        @apply text-2xl font-bold mb-3;
        color: var(--color-pp-light);
    }

    .cta-subtitle {
        @apply mb-6;
        color: color-mix(in srgb, var(--color-pp-light) 80%, transparent);
    }

    .cta-buttons {
        @apply flex flex-col gap-3 justify-center;
        @apply sm:flex-row;
    }

    .btn-cta-primary {
        @apply p-3 px-6 rounded-lg font-semibold no-underline transition-colors;
        background-color: var(--color-pp-light);
        color: var(--color-pp-primary);
    }

    .btn-cta-primary:hover {
        background-color: var(--color-pp-secondary);
    }

    .btn-cta-secondary {
        @apply p-3 px-6 rounded-lg no-underline transition-colors;
        border: 1px solid color-mix(in srgb, var(--color-pp-light) 50%, transparent);
        color: var(--color-pp-light);
    }

    .btn-cta-secondary:hover {
        background-color: color-mix(in srgb, var(--color-pp-light) 10%, transparent);
    }
</style>
