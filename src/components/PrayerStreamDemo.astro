---
import PrayerStreamWidget from "./PrayerStreamWidget.astro";
---

<div class="prayer-stream-demo">
    <div class="demo-callout">
        <i class="fas fa-info-circle"></i>
        <span
            >This is a demo for illustrative purposes only. Prayer content,
            interval, and logging period may vary.</span
        >
    </div>

    <div class="widgets-showcase">
        <!-- <button
            class="prayer-tab"
            data-tradition="demo"
            data-icon="fa-solid fa-star"
            data-color="text-red-600"
        >
            <PrayerStreamWidget
                text="Prayer Stream"
                iconClass="fa-solid fa-star"
                bgClass="bg-red-500"
            />
        </button> -->
        <button
            class="prayer-tab active"
            data-tradition="buddhist"
            data-icon="fa-solid fa-om"
            data-color="text-indigo-600"
        >
            <PrayerStreamWidget
                text="Buddhist"
                iconClass="fa-solid fa-om"
                bgClass="bg-indigo-500"
            />
        </button>
        <button
            class="prayer-tab"
            data-tradition="christian"
            data-icon="fa-solid fa-cross"
            data-color="text-emerald-600"
        >
            <PrayerStreamWidget
                text="Christian"
                iconClass="fa-solid fa-cross"
                bgClass="bg-emerald-500"
            />
        </button>
        <button
            class="prayer-tab"
            data-tradition="taoist"
            data-icon="fa-solid fa-yin-yang"
            data-color="text-amber-600"
        >
            <PrayerStreamWidget
                text="Taoist"
                iconClass="fa-solid fa-yin-yang"
                bgClass="bg-amber-500"
            />
        </button>
    </div>

    <div class="prayer-log">
        <div class="prayer-log-header">
            <i class="fas fa-list text-slate-500"></i>
            <span class="font-semibold text-sm">Recent Prayers</span>
        </div>
        <div class="prayer-log-entries" id="prayer-log-entries">
            <!-- Entries will be populated by JS -->
        </div>
    </div>
</div>

<style>
    @reference "tailwindcss";

    .prayer-stream-demo {
        @apply flex flex-col gap-4;
    }

    .demo-callout {
        @apply flex items-center gap-2 px-3 py-2 rounded-lg text-sm;
        @apply bg-blue-50 text-blue-700 border border-blue-200;
    }

    .widgets-showcase {
        @apply flex flex-wrap gap-4 items-center justify-center my-4;
    }

    .prayer-tab {
        @apply cursor-pointer rounded-lg p-1;
        @apply transition-all;
        @apply border-2 border-transparent;
    }

    .prayer-tab:hover {
        @apply scale-105;
    }

    .prayer-tab.active {
        @apply border-slate-400 scale-105;
    }

    .prayer-log {
        @apply bg-slate-50 border border-slate-300 rounded-lg overflow-hidden;
    }

    .prayer-log-header {
        @apply bg-slate-200 px-4 py-2 border-b border-slate-300 flex items-center gap-2;
    }

    .prayer-log-entries {
        @apply divide-y divide-slate-200 overflow-hidden;
        height: 295px;
    }

    :global(.prayer-entry) {
        @apply px-4 py-2 flex flex-row items-center justify-between gap-3;
        @apply transition-all duration-300;
    }

    :global(.prayer-entry.entering) {
        animation: slideIn 0.3s ease-out forwards;
    }

    :global(.prayer-entry.exiting) {
        animation: slideOut 0.3s ease-out forwards;
    }

    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-100%);
            max-height: 0;
        }
        to {
            opacity: 1;
            transform: translateY(0);
            max-height: 44px;
        }
    }

    @keyframes slideOut {
        from {
            opacity: 1;
            max-height: 44px;
        }
        to {
            opacity: 0;
            max-height: 0;
        }
    }

    :global(.prayer-entry-content) {
        @apply flex-1 flex items-center justify-start gap-2;
    }

    :global(.prayer-time) {
        @apply text-xs text-slate-400 whitespace-nowrap;
    }

    :global(.prayer-text) {
        @apply text-slate-700 text-sm;
    }
</style>

<script>
    // Prayer Stream Demo
    const prayerTabs = document.querySelectorAll(".prayer-tab");
    const prayerLogEntries = document.getElementById("prayer-log-entries");
    const MAX_ENTRIES = 10;
    const ADD_INTERVAL = 3000;

    const traditions: Record<string, any> = {
        demo: {
            icon: "fa-solid fa-star",
            color: "text-red-600",
            prayers: [
                "(Your prayers/chants here!)",
                "(Your prayers/chants here!)",
                "(Your prayers/chants here!)",
                "(Your prayers/chants here!)",
            ],
        },
        buddhist: {
            icon: "fa-solid fa-om",
            color: "text-indigo-600",
            prayers: [
                "ॐ मणिपद्मे हूँ",
                "南無阿彌陀佛",
                "南無觀世音菩薩",
                "嗡嘛呢叭咪吽",
            ],
        },
        christian: {
            icon: "fa-solid fa-cross",
            color: "text-emerald-600",
            prayers: [
                "Our Father, who art in heaven...",
                "Hail Mary, full of grace...",
                "The Lord is my shepherd...",
                "Glory be to the Father...",
            ],
        },
        taoist: {
            icon: "fa-solid fa-yin-yang",
            color: "text-amber-600",
            prayers: [
                "太上老君急急如律令",
                "道生一，一生二，二生三，三生萬物",
                "無為而無不為",
                "上善若水",
            ],
        },
    };

    let currentTradition = "buddhist";
    let prayerIndex = 0;

    function getTimeString() {
        const now = new Date();
        return now.toLocaleTimeString("en-US", {
            hour: "numeric",
            minute: "2-digit",
            second: "2-digit",
            hour12: true,
        });
    }

    function createEntry(tradition: string) {
        const t = traditions[tradition];
        const prayer = t.prayers[prayerIndex % t.prayers.length];
        prayerIndex++;

        const entry = document.createElement("div");
        entry.className = "prayer-entry entering";
        entry.innerHTML = `
            <div class="prayer-entry-content">
                <i class="${t.icon} ${t.color}"></i>
                <span class="prayer-text">${prayer}</span>
            </div>
            <span class="prayer-time">${getTimeString()}</span>
        `;
        return entry;
    }

    function addNewEntry() {
        if (!prayerLogEntries) return;

        const entries = prayerLogEntries.querySelectorAll(".prayer-entry");

        // Remove excess entries
        if (entries.length >= MAX_ENTRIES) {
            const lastEntry = entries[entries.length - 1];
            lastEntry.classList.add("exiting");
            setTimeout(() => lastEntry.remove(), 300);
        }

        // Add new entry at top
        const newEntry = createEntry(currentTradition);
        prayerLogEntries.insertBefore(newEntry, prayerLogEntries.firstChild);

        // Remove entering class after animation
        setTimeout(() => newEntry.classList.remove("entering"), 300);
    }

    function initializeEntries() {
        if (!prayerLogEntries) return;
        prayerLogEntries.innerHTML = "";
        prayerIndex = 0;
        for (let i = 0; i < MAX_ENTRIES; i++) {
            const entry = createEntry(currentTradition);
            entry.classList.remove("entering");
            prayerLogEntries.appendChild(entry);
        }
    }

    // Tab switching
    prayerTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
            const tradition = tab.getAttribute("data-tradition");
            if (tradition === currentTradition) return;
            if (!tradition) return;

            currentTradition = tradition;
            prayerTabs.forEach((t) => t.classList.remove("active"));
            tab.classList.add("active");
            initializeEntries();
        });
    });

    // Initialize and start animation
    initializeEntries();
    setInterval(addNewEntry, ADD_INTERVAL);
</script>
