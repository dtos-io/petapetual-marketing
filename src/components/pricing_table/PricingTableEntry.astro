---
const {
    name,
    desc,
    monthlyPrice,
    annualMonthlyPrice,
    nMemorials,
    baseColor,
    compareID,
    isSpecial,
} = Astro.props;

let annualYearlyPrice = annualMonthlyPrice * 12;
let annualDiscount =
    Math.round((100 * (monthlyPrice - annualMonthlyPrice)) / monthlyPrice) || 0;

let memorialWord =
    "memorial" + (nMemorials > 1 || nMemorials === "unlimited" ? "s" : "");

// Map base colors to slate-compatible accent colors
const colorMap: Record<string, { text: string; bg: string; border: string }> = {
    stone: { text: "text-slate-600", bg: "bg-slate-600", border: "border-slate-300" },
    sky: { text: "text-sky-600", bg: "bg-sky-600", border: "border-sky-200" },
    amber: { text: "text-amber-600", bg: "bg-amber-600", border: "border-amber-200" },
    emerald: { text: "text-emerald-600", bg: "bg-emerald-600", border: "border-emerald-200" },
    indigo: { text: "text-indigo-600", bg: "bg-indigo-600", border: "border-indigo-200" },
};

const colors = colorMap[baseColor] || colorMap.stone;
const compareAnchorID = compareID ?? "compare";
---

<pricing-table
    data-pricing={JSON.stringify({ monthlyPrice, annualMonthlyPrice })}
    class:list={[
        "pricing-card",
        { "pricing-card-special": isSpecial },
    ]}
>
    <div class="pricing-card-header">
        <div class="pricing-card-title-row">
            <h3 class:list={["pricing-card-name", colors.text]}>
                {name}
            </h3>
            {isSpecial && (
                <div class="popular-badge">
                    <i class="fas fa-fire-flame-curved"></i>
                    <span>Popular</span>
                </div>
            )}
        </div>
        <p class="pricing-card-desc">{desc}</p>
    </div>

    <div class="pricing-card-price">
        <div class="price-main">
            <span class:list={["price-amount", colors.text]}>
                $<span id="price-per-month">{monthlyPrice}</span>
            </span>
            <span class="price-period">/ month</span>
        </div>

        <div id="annual-billing-notice" class="annual-notice">
            Billed at <strong>${annualYearlyPrice}</strong> yearly
            <span class="annual-savings">({annualDiscount}% off)</span>
        </div>

        <a
            class:list={["pricing-cta-btn", colors.bg]}
            href="https://app.petapetual.com"
        >
            Get Started <i class="fas fa-arrow-right ml-1"></i>
        </a>
    </div>

    <hr class="pricing-divider" />

    <div class="pricing-features">
        <ul class="features-list">
            <li class="feature-item">
                <i class:list={["fas fa-dove feature-icon", colors.text]}></i>
                <span>
                    Create <strong>{nMemorials}</strong> {memorialWord}
                </span>
            </li>
        </ul>

        <slot />
    </div>

    <a class="compare-link" href={`#${compareAnchorID}`}>
        Compare Plans <i class="fas fa-arrow-down ml-1"></i>
    </a>
</pricing-table>

<style>
    @reference "tailwindcss";

    .pricing-card {
        @apply p-6 rounded-xl grid gap-4;
        @apply bg-white border border-slate-200 shadow-sm;
        @apply hover:shadow-md transition-shadow;
        /* Define consistent row heights */
        grid-template-rows: auto auto auto 1fr auto;
    }

    .pricing-card-special {
        @apply border-amber-300 shadow-md;
        @apply ring-2 ring-amber-200;
    }

    .pricing-card-header {
        @apply flex flex-col gap-1;
    }

    .pricing-card-title-row {
        @apply flex items-center justify-between;
    }

    .pricing-card-name {
        @apply text-xl font-bold;
    }

    .popular-badge {
        @apply flex items-center gap-1 text-amber-500 text-sm font-medium;
    }

    .pricing-card-desc {
        @apply text-slate-500 text-sm italic leading-snug;
        min-height: 3rem; /* Fixed height for ~2-3 lines to ensure alignment */
    }

    .pricing-card-price {
        @apply flex flex-col gap-2;
    }

    .price-main {
        @apply flex items-baseline gap-1;
    }

    .price-amount {
        @apply text-3xl font-bold;
    }

    .price-period {
        @apply text-slate-500;
    }

    .annual-notice {
        @apply text-sm text-slate-500 leading-snug;
        min-height: 2.25rem; /* Fixed height for 2 lines to ensure alignment */
    }

    .annual-savings {
        @apply text-emerald-600 font-medium;
    }

    .pricing-cta-btn {
        @apply text-center p-2.5 rounded-lg text-white font-medium;
        @apply hover:opacity-90 transition-opacity;
    }

    .pricing-divider {
        @apply border-slate-200;
    }

    .pricing-features {
        @apply flex flex-col gap-3;
        /* This row has 1fr so it grows to fill available space */
    }

    .features-list {
        @apply flex flex-col gap-2;
    }

    .feature-item {
        @apply flex items-center gap-2 text-slate-600 text-sm;
    }

    .feature-icon {
        @apply w-4;
    }

    .compare-link {
        @apply p-2 text-center text-slate-400 border border-slate-200 rounded-lg text-sm;
        @apply hover:bg-slate-50 hover:text-slate-600 transition-colors;
        /* This stays at the bottom due to grid */
    }
</style>

<script>
    import { subscriptionCycleToggle } from "../../store.js";

    class PricingTable extends HTMLElement {
        constructor() {
            super();
            const { monthlyPrice, annualMonthlyPrice } = JSON.parse(
                this.dataset.pricing ?? "{}",
            );
            const pricePerMonth = this.querySelector("#price-per-month");
            const annualBillingNotice = this.querySelector(
                "#annual-billing-notice",
            );

            subscriptionCycleToggle.subscribe((subCycle: string) => {
                if (subCycle === "monthly") {
                    pricePerMonth!.innerHTML = monthlyPrice;
                    annualBillingNotice?.classList.add("hidden");
                }

                if (subCycle === "annually") {
                    pricePerMonth!.innerHTML = annualMonthlyPrice;
                    annualBillingNotice?.classList.remove("hidden");
                }
            });
        }
    }

    customElements.define("pricing-table", PricingTable);
</script>
