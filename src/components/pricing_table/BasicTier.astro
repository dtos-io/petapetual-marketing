---
import PricingTableEntry from "./PricingTableEntry.astro";
---

<PricingTableEntry
    name="Basic"
    desc="For single memorials, and the basic experience."
    monthlyPrice="9.99"
    annualMonthlyPrice="9.00"
    baseColor="sky"
    nMemorials="1"
>
    <li><i class="fas fa-star"></i>Everything from lower tiers</li>
    <li><i class="fas fa-plus"></i>Guestbook</li>
    <li>
        <i class="fas fa-plus"></i><a
            class="blueLink"
            href="/how-it-works/prayer-streams">Prayer streams</a
        >
    </li>
</PricingTableEntry>

<style>
    li > i.fas {
        color: var(--color-sky-600);
    }
</style>
