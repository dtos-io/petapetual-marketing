---
import TableHeader from "./TableHeader.astro";
import { default as TR } from "./TableRow.astro";
import { default as TD } from "./TableCell.astro";
---

<div
    class="relative flex flex-col w-full h-full text-slate-700 bg-white rounded-xl bg-clip-border z-0 overflow-x-auto"
>
    <table class="w-full text-left table-auto min-w-max">
        <thead>
            <tr>
                <TableHeader noCenter>Plan</TableHeader>
                <TableHeader>Free</TableHeader>
                <TableHeader textClass="text-sky-600">Basic</TableHeader>
                <TableHeader textClass="text-amber-600"
                    >Essentials <i class="fas fa-fire-flame-curved"
                    ></i></TableHeader
                >
                <TableHeader textClass="text-emerald-600">Premium</TableHeader>
                <TableHeader textClass="text-indigo-600">Unlimited</TableHeader>
            </tr>
        </thead>
        <tbody>
            <TR>
                <TD noCenter>Memorials</TD>
                <TD>1</TD>
                <TD>1</TD>
                <TD>2</TD>
                <TD>4</TD>
                <TD><i class="fas fa-infinity"></i><sup> 1</sup></TD>
            </TR>

            <TR>
                <TD noCenter>Invite Others</TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
            </TR>

            <TR>
                <TD noCenter>Public Memorials</TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
            </TR>

            <TR>
                <TD noCenter>Guestbook</TD>
                <TD>-</TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
            </TR>

            <TR>
                <TD noCenter>Prayer Streams</TD>
                <TD>-</TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
                <TD><i class="fas fa-circle-check text-green-500"></i></TD>
            </TR>

            <TR>
                <TD noCenter
                    >Family Trees <span
                        class="text-xs bg-amber-400 px-2 py-1 rounded-lg"
                        >Coming Soon!</span
                    ></TD
                >
                <TD>-</TD>
                <TD>-</TD>
                <TD><i class="far fa-clock text-amber-500"></i></TD>
                <TD><i class="far fa-clock text-amber-500"></i></TD>
                <TD><i class="far fa-clock text-amber-500"></i></TD>
            </TR>

            <TR>
                <TD noCenter
                    >Memorial Tributes <span
                        class="text-xs bg-amber-400 px-2 py-1 rounded-lg"
                        >Coming Soon!</span
                    ></TD
                >
                <TD>-</TD>
                <TD>-</TD>
                <TD><i class="far fa-clock text-amber-500"></i></TD>
                <TD><i class="far fa-clock text-amber-500"></i></TD>
                <TD><i class="far fa-clock text-amber-500"></i></TD>
            </TR>
        </tbody>
    </table>
</div>
