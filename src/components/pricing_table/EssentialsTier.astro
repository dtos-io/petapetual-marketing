---
import PricingTableEntry from "./PricingTableEntry.astro";
---

<PricingTableEntry
    name="Essentials"
    desc="Two plots, and access to our virtual tribute service."
    monthlyPrice="16.99"
    annualMonthlyPrice="14.00"
    baseColor="amber"
    nMemorials="2"
    isSpecial
>
    <li><i class="fas fa-star"></i>Everything from lower tiers</li>

    <li class="font-bold text-xs">Coming Soon:</li>

    <li>
        <i class="fas fa-plus"></i>Virtual <a
            class="blueLink"
            href="/how-it-works/tributes">tributes</a
        >
    </li>
    <li>
        <i class="fas fa-plus"></i><a
            class="blueLink"
            href="/how-it-works/family-trees">Family trees</a
        >
    </li>
</PricingTableEntry>

<style>
    li > i.fas {
        color: var(--color-amber-600);
    }
</style>
