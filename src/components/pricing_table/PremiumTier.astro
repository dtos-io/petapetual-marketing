---
import PricingTableEntry from "./PricingTableEntry.astro";
---

<PricingTableEntry
    name="Premium"
    desc="Small family plots, customizable and publishable."
    monthlyPrice="24.99"
    annualMonthlyPrice="20.00"
    baseColor="emerald"
    nMemorials="4"
>
    <li><i class="fas fa-star"></i>Everything from lower tiers</li>
    <li>
        <i class="fas fa-plus"></i>Custom <a
            href="/how-it-works/prayer-streams"
            class="blueLink">prayer streams</a
        >
    </li>
</PricingTableEntry>

<style>
    li > i.fas {
        color: var(--color-emerald-600);
    }
</style>
