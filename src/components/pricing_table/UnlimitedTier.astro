---
import PricingTableEntry from "./PricingTableEntry.astro";
---

<PricingTableEntry
    name="Unlimited"
    desc="For remembering generations past and future."
    monthlyPrice="49.99"
    annualMonthlyPrice="40.00"
    baseColor="indigo"
    nMemorials="unlimited"
>
    <li><i class="fas fa-star"></i>Everything from lower tiers</li>
    <li>
        <i class="fas fa-star"></i>No memorial creation limits!
        <span>
            <sup> 1</sup>
        </span>
    </li>
</PricingTableEntry>

<style>
    li > i.fas {
        color: var(--color-indigo-600);
    }
</style>
