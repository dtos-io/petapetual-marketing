---
import PricingTableEntry from "./PricingTableEntry.astro";
---

<PricingTableEntry
    name="Unlimited"
    desc="For remembering generations past and future."
    monthlyPrice="49.99"
    annualMonthlyPrice="40.00"
    baseColor="indigo"
    nMemorials="unlimited"
>
    <ul>
        <li><i class="fas fa-star mr-2"></i>Everything from lower tiers</li>
        <li>
            <i class="fas fa-star mr-2"></i>No memorial creation limits!<sup>
                1</sup
            >
        </li>
    </ul>
</PricingTableEntry>

<style>
    li > i.fas {
        color: var(--color-indigo-600);
    }
</style>
