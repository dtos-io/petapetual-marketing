---
import BaseHead from "../components/BaseHead.astro";
import StickyNav from "../components/StickyNav.astro";
import Footer from "../components/Footer.astro";

import "../styles/global.css";

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en" class="text-stone-800 bg-stone-100 font-light">
    <head>
        <!-- Schema to map Petapetual as a name for the URL Petapetual -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "WebSite",
                "name": "Petapetual",
                "alternateName": ["Petapetual"],
                "url": "https://petapetual.com/"
            }
        </script>

        <!-- Google tag (gtag.js) -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-HFEKKX4VEP"
        ></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());

            gtag("config", "G-HFEKKX4VEP");
        </script>

        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta
            property="og:image"
            content={new URL("/og-image.png", Astro.site)}
        />
        <meta property="og:site_name" content="Petapetual" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta
            name="twitter:image"
            content={new URL("/og-image.png", Astro.site)}
        />

        <!-- sitemap -->
        <link rel="sitemap" href="/sitemap-index.xml" />

        <BaseHead title={title} />
    </head>

    <body class="body-container">
        <StickyNav />

        <main class="min-h-[50vh]">
            <slot />
        </main>

        <Footer />
    </body>
</html>

